rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function owner(uid) {
      return googleUser() && request.auth.uid == uid;
    }

    function initialAttribute(attribute) {
      return attribute.keys().hasOnly(['level', 'xp']) && attribute.level == 1 && attribute.xp == 0;
    }

    function initialCharacter(character) {
      return character.keys().hasOnly(['generalLevel', 'class', 'attributes'])
        && character.generalLevel == 1 && character.get('class', '') == 'Novato'
        && character.attributes.keys().hasAll(['STR', 'DEX', 'CON', 'INT', 'WIT', 'MEN'])
        && character.attributes.keys().hasOnly(['STR', 'DEX', 'CON', 'INT', 'WIT', 'MEN'])
        && initialAttribute(character.attributes.STR)
        && initialAttribute(character.attributes.DEX)
        && initialAttribute(character.attributes.CON)
        && initialAttribute(character.attributes.INT)
        && initialAttribute(character.attributes.WIT)
        && initialAttribute(character.attributes.MEN);
    }

    match /accounts/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['username', 'usernameKey', 'character'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{1,15}$')
        && request.resource.data.usernameKey == request.resource.data.username.lower()
        && initialCharacter(request.resource.data.character)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameKey)).data.uid == uid;
      allow update, delete: if false;
    }

    match /usernames/{key} {
      allow get: if false;
      allow list: if false;
      allow create: if googleUser()
        && key.matches('^[a-z0-9_]{1,15}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.usernameKey == key;
      allow update, delete: if false;
    }

    // Reglas ya publicadas para los registros de la aplicación existente.
    match /users/{userId}/records/{recordId} {
      function recordOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function matchesCatalog(d) {
        return (d.catalogId == 'MEAL' && d.kind == 'meal' && d.primary == 'CON' && d.secondary == null && d.minutes == 0)
          || (d.catalogId == 'SLEEP' && d.kind == 'sleep' && d.primary == 'MEN' && d.secondary == null && d.minutes > 0)
          || (d.kind == 'duration' && d.minutes > 0 && (
            (d.catalogId == 'STRENGTH' && d.primary == 'STR' && d.secondary == null)
            || (d.catalogId == 'AEROBIC' && d.primary == 'DEX' && d.secondary == null)
            || (d.catalogId == 'READ' && d.primary == 'INT' && d.secondary == null)
            || (d.catalogId == 'HOBBY' && d.primary == 'WIT' && d.secondary == null)
            || (d.catalogId == 'CROSSFIT' && d.primary == 'STR' && d.secondary == 'DEX')
            || (d.catalogId == 'MARTIAL_ARTS' && d.primary == 'DEX' && d.secondary == 'STR')
            || (d.catalogId == 'YOGA' && d.primary == 'WIT' && d.secondary == 'DEX')
            || (d.catalogId == 'PRACTICAL_SKILL' && d.primary == 'INT' && d.secondary == 'DEX')
            || (d.catalogId == 'STRATEGY' && d.primary == 'WIT' && d.secondary == 'INT')
          ));
      }
      function validRecord() {
        let d = request.resource.data;
        return d.keys().hasOnly(['date', 'createdAt', 'kind', 'minutes', 'primary', 'secondary', 'catalogId'])
          && d.keys().hasAll(['date', 'createdAt', 'kind', 'minutes', 'primary', 'secondary', 'catalogId'])
          && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.createdAt is int && d.createdAt > 0
          && d.kind in ['duration', 'sleep', 'meal']
          && d.minutes is int && d.minutes >= 0 && d.minutes <= 2147483647
          && d.primary is string && d.primary in ['STR', 'DEX', 'CON', 'INT', 'WIT', 'MEN']
          && d.catalogId is string && d.catalogId in ['STRENGTH', 'AEROBIC', 'MEAL', 'READ', 'HOBBY', 'SLEEP', 'CROSSFIT', 'MARTIAL_ARTS', 'YOGA', 'PRACTICAL_SKILL', 'STRATEGY']
          && (d.secondary == null || (d.secondary is string && d.secondary in ['STR', 'DEX', 'INT', 'WIT', 'MEN']))
          && matchesCatalog(d);
      }
      allow get, list: if recordOwner();
      allow create: if recordOwner() && validRecord();
      // Los reintentos idénticos son inocuos; el cambio de registros se implementará más adelante.
      allow update: if recordOwner() && request.resource.data == resource.data;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
